---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  intro: string;
  /** 写真あり（16:6）か、無地ダーク（contact）か */
  variant?: 'photo' | 'plain';
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, intro, variant = 'photo', image, imageAlt = '' } = Astro.props;
---

<header class:list={['page-header', `is-${variant}`]}>
  {
    variant === 'photo' && image && (
      <div class="ph-media zi-media" aria-hidden={imageAlt ? undefined : 'true'}>
        <Image src={image} alt={imageAlt} widths={[768, 1600]} sizes="100vw" fetchpriority="high" />
      </div>
    )
  }
  <div class="ph-overlay" aria-hidden="true"></div>
  <div class="zi-container ph-inner">
    <h1 class="ph-title">{title}</h1>
    <p class="ph-intro">{intro}</p>
  </div>
</header>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    color: var(--paper);
    background-color: var(--ink-900);
    display: flex;
    align-items: flex-end;
  }
  /* 16:6 の横長。下層ページ共通形式 */
  .is-photo {
    aspect-ratio: 16 / 6;
    min-height: 320px;
  }
  .is-plain {
    min-height: 46vh;
    padding-top: 72px;
  }
  .ph-media {
    position: absolute;
    inset: 0;
  }
  .ph-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ph-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(11, 10, 9, 0.5) 0%,
      rgba(11, 10, 9, 0.45) 50%,
      rgba(11, 10, 9, 0.8) 100%
    );
  }
  .is-plain .ph-overlay {
    background: none;
  }
  .ph-inner {
    position: relative;
    padding-block: clamp(32px, 6vh, 72px);
  }
  .ph-title {
    color: var(--white);
  }
  .ph-intro {
    margin-top: 18px;
    max-width: 52ch;
    color: var(--gray-300);
    font-size: 1.0625rem;
  }
</style>
