---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n/ui';
import PageHeader from '../PageHeader.astro';
import ContactForm from '../ContactForm.astro';
import FadeIn from '../FadeIn.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const c = t.pages.contact;

const CLIPYIELD_URL = 'https://chisato1113-hash.github.io/CLIPYIELD.io/';
// 送信後遷移先：各言語の /contact/thanks/
const thanksHref = getRelativeLocaleUrl(locale, 'contact/thanks');
const title = `${c.header.title}｜${t.meta.siteName}`;
---

<BaseLayout locale={locale} title={title} description={c.header.intro} slug="contact">
  <PageHeader title={c.header.title} intro={c.header.intro} variant="plain" />

  <section class="zi-section zi-surface-paper">
    <div class="zi-container contact-grid">
      <FadeIn class="form-col">
        <ContactForm locale={locale} action={thanksHref} clipyieldUrl={CLIPYIELD_URL} />
      </FadeIn>

      <FadeIn class="aside-col">
        <aside class="other">
          <h2 class="zi-label other-heading">{c.otherHeading}</h2>
          <dl class="other-list">
            <div>
              <dt>{c.emailLabel}</dt>
              {/* TODO(z-ip): 問い合わせ用メールアドレスが確定次第記載（付録A） */}
              <dd class="pending">—</dd>
            </div>
            <div>
              <dt>{c.addressLabel}</dt>
              {/* TODO(z-ip): 所在地が確定次第記載（付録A） */}
              <dd class="pending">—</dd>
            </div>
          </dl>
        </aside>
      </FadeIn>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1.6fr 1fr;
      gap: 80px;
    }
  }
  .other {
    border-top: 1px solid var(--gray-200);
    padding-top: 28px;
  }
  .other-heading {
    color: var(--gray-500);
    margin-bottom: 24px;
  }
  .other-list > div + div {
    margin-top: 20px;
  }
  .other-list dt {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gray-500);
  }
  .other-list dd {
    margin-top: 4px;
    color: var(--text);
  }
  .pending {
    color: var(--gray-500);
  }
</style>
