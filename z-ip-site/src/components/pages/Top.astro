---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n/ui';
import HeroVideo from '../HeroVideo.astro';
import SectionHeading from '../SectionHeading.astro';
import EngineCard from '../EngineCard.astro';
import FadeIn from '../FadeIn.astro';

import enginePanel from '../../assets/images/engine-panel.jpg';
import engineClipyield from '../../assets/images/engine-clipyield.jpg';
import closingImg from '../../assets/images/closing.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const servicesHref = getRelativeLocaleUrl(locale, 'services');
const contactHref = getRelativeLocaleUrl(locale, 'contact');
---

<BaseLayout
  locale={locale}
  title={t.meta.titleTop}
  description={t.meta.descTop}
  slug=""
  transparentStart={true}
>
  <!-- [T-1] ヒーロー -->
  <HeroVideo label={t.hero.label} heading={t.hero.heading} sub={t.hero.sub} scrollHint={t.hero.scrollHint} />

  <!-- [T-2] ステートメント -->
  <section id="statement" class="zi-section zi-surface-paper">
    <div class="zi-container statement">
      <FadeIn>
        {t.statement.lines.map((line) => <p class="statement-line">{line}</p>)}
      </FadeIn>
    </div>
  </section>

  <!-- [T-3] 2つのエンジン -->
  <section id="engines" class="zi-section zi-surface-paper engines">
    <div class="zi-container">
      <FadeIn>
        <SectionHeading label={t.engines.label} align="center" />
      </FadeIn>
      <div class="engines-grid">
        <FadeIn>
          <EngineCard
            image={enginePanel}
            imageAlt={t.engines.a.imageAlt}
            tag={t.engines.a.tag}
            name={t.engines.a.name}
            label={t.engines.a.label}
            heading={t.engines.a.heading}
            body={t.engines.a.body}
            linkHref={servicesHref}
            linkLabel={t.common.viewService}
          />
        </FadeIn>
        <FadeIn delay={80}>
          <EngineCard
            image={engineClipyield}
            imageAlt={t.engines.b.imageAlt}
            tag={t.engines.b.tag}
            name={t.engines.b.name}
            label={t.engines.b.label}
            heading={t.engines.b.heading}
            body={t.engines.b.body}
            linkHref={servicesHref}
            linkLabel={t.common.viewService}
          />
        </FadeIn>
      </div>
      <FadeIn>
        <p class="engines-relation">{t.engines.relation}</p>
      </FadeIn>
    </div>
  </section>

  <!-- [T-5] Moat -->
  <section id="moat" class="zi-section zi-surface-paper">
    <div class="zi-container">
      <FadeIn>
        <SectionHeading label={t.moat.label} />
      </FadeIn>
      <div class="moat-grid">
        {t.moat.items.map((item, i) => (
          <FadeIn delay={i * 80}>
            <div class="moat-item">
              <span class="moat-no">{item.no}</span>
              <h3 class="moat-title">{item.title}</h3>
              <p class="moat-body">{item.body}</p>
            </div>
          </FadeIn>
        ))}
      </div>
    </div>
  </section>

  {/* [T-6] 数値ストリップ — 【要確認】KPI が未確定のためブロックごと非表示。
      TODO(z-ip): 確定値を入れる。未確定のままリリースしない。推定値・目標値は置かない（第9章）。 */}

  <!-- [T-7] クロージング CTA -->
  <section id="cta" class="closing zi-surface-ink-900">
    <div class="closing-bg zi-media" aria-hidden="true">
      <Image src={closingImg} alt="" widths={[800, 1600]} sizes="100vw" loading="lazy" />
    </div>
    <div class="zi-container closing-inner">
      <FadeIn>
        <h2 class="closing-heading">{t.closing.heading}</h2>
        <p class="closing-body">{t.closing.body}</p>
        <a class="zi-btn closing-cta" href={contactHref}>{t.closing.ctaLabel}</a>
      </FadeIn>
    </div>
  </section>
</BaseLayout>

<style>
  /* [T-2] */
  .statement {
    max-width: 820px;
    text-align: center;
  }
  .statement-line {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.375rem, 3vw, 2rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .statement-line + .statement-line {
    margin-top: 1.2em;
  }

  /* [T-3] */
  .engines-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    margin-top: 56px;
  }
  @media (min-width: 768px) {
    .engines-grid {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }
  }
  .engines-relation {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--gray-200);
    max-width: 60ch;
    color: var(--gray-500);
    font-size: 1.0625rem;
  }

  /* [T-5] */
  .moat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin-top: 48px;
  }
  .moat-item {
    padding: 32px 0;
    border-top: 1px solid var(--gray-200);
  }
  @media (min-width: 768px) {
    .moat-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }
    .moat-item {
      padding: 8px 32px 8px 0;
      border-top: none;
      border-left: 1px solid var(--gray-200);
      padding-left: 32px;
    }
    .moat-item:first-child {
      border-left: none;
      padding-left: 0;
    }
  }
  .moat-no {
    font-family: var(--font-label);
    font-weight: 400;
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    line-height: 1;
    color: var(--vermillion);
  }
  .moat-title {
    margin-top: 20px;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
  }
  .moat-body {
    margin-top: 12px;
    color: var(--gray-500);
    font-size: 0.9375rem;
  }

  /* [T-7] */
  .closing {
    position: relative;
    overflow: hidden;
    padding-block: clamp(96px, 16vh, 200px);
  }
  .closing-bg {
    position: absolute;
    inset: 0;
    opacity: 0.35;
  }
  .closing-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .closing-inner {
    position: relative;
    text-align: center;
  }
  .closing-heading {
    color: var(--white);
  }
  .closing-body {
    margin-top: 20px;
    color: var(--gray-300);
    max-width: 48ch;
    margin-inline: auto;
  }
  .closing-cta {
    margin-top: 40px;
  }
</style>
