---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** 送信後遷移先（各言語の /contact/thanks/） */
  action: string;
  clipyieldUrl: string;
}
const { locale, action, clipyieldUrl } = Astro.props;
const c = useTranslations(locale).pages.contact;
---

<!--
  Netlify Forms（第1候補）。静的HTMLに form が存在するため検知される。
  data-netlify + netlify-honeypot でスパム対策。送信後 action の thanks ページへ遷移。
  {/* TODO(z-ip): ホスティングが GitHub Pages に決まった場合は Netlify Forms が使えないため
     Formspree（action を Formspree エンドポイントに変更）へ切り替える。付録A・第6-4章。 */}
  バリデーションは HTML 標準（required / type=email）を基本とし、
  エラー表示（朱の下線＋朱テキスト）は :user-invalid による CSS のみで行う（追加JSなし）。
-->
<form
  class="cform"
  name="contact"
  method="POST"
  action={action}
  data-netlify="true"
  netlify-honeypot="bot-field"
>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hp" hidden>
    <label>Do not fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <!-- 種別 -->
  <div class="field">
    <label class="flabel" for="cf-type">{c.typeLabel} <span class="req">{c.required}</span></label>
    <select id="cf-type" name="type" required>
      <option value="" selected disabled>{c.typePlaceholder}</option>
      <option value="entrust">{c.types.entrust}</option>
      <option value="distribute">{c.types.distribute}</option>
      <option value="clipper">{c.types.clipper}</option>
      <option value="recruit">{c.types.recruit}</option>
      <option value="press">{c.types.press}</option>
      <option value="other">{c.types.other}</option>
    </select>
    <span class="err">{c.errorRequired}</span>
    <!-- クリッパー参加はフォームではなく CLIPYIELD へ誘導（常時表示・第6-4章） -->
    <p class="clipper-note">
      {c.clipperNotice}
      <a class="zi-textlink" href={clipyieldUrl} target="_blank" rel="noopener">{c.clipperLink} ↗</a>
    </p>
  </div>

  <!-- お名前 -->
  <div class="field">
    <label class="flabel" for="cf-name">{c.labelName} <span class="req">{c.required}</span></label>
    <input id="cf-name" name="name" type="text" required placeholder=" " autocomplete="name" />
    <span class="err">{c.errorRequired}</span>
  </div>

  <!-- 会社・団体名（任意） -->
  <div class="field">
    <label class="flabel" for="cf-company">{c.labelCompany} <span class="opt">{c.optional}</span></label>
    <input id="cf-company" name="company" type="text" placeholder=" " autocomplete="organization" />
  </div>

  <!-- メール -->
  <div class="field">
    <label class="flabel" for="cf-email">{c.labelEmail} <span class="req">{c.required}</span></label>
    <input id="cf-email" name="email" type="email" required placeholder=" " autocomplete="email" />
    <span class="err err-required">{c.errorRequired}</span>
    <span class="err err-email">{c.errorEmail}</span>
  </div>

  <!-- 国・地域（任意） -->
  <div class="field">
    <label class="flabel" for="cf-country">{c.labelCountry} <span class="opt">{c.optional}</span></label>
    <select id="cf-country" name="country">
      <option value="" selected disabled>{c.countryPlaceholder}</option>
      {c.countries.map((country) => <option value={country}>{country}</option>)}
    </select>
  </div>

  <!-- 内容 -->
  <div class="field">
    <label class="flabel" for="cf-message">{c.labelMessage} <span class="req">{c.required}</span></label>
    <textarea id="cf-message" name="message" rows="6" required placeholder=" "></textarea>
    <span class="err">{c.errorRequired}</span>
  </div>

  <!-- 同意 -->
  <div class="field field-check">
    <label class="check">
      <input type="checkbox" name="consent" required />
      <span>{c.labelConsent} <span class="req">{c.required}</span></span>
    </label>
    <span class="err err-check">{c.errorConsent}</span>
  </div>

  <button type="submit" class="zi-btn cform-submit">{c.submit}</button>
</form>

<style>
  .cform {
    display: flex;
    flex-direction: column;
    gap: 36px;
    max-width: 640px;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .field {
    display: flex;
    flex-direction: column;
  }
  .flabel {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray-500);
    margin-bottom: 10px;
  }
  .req {
    color: var(--vermillion);
    margin-left: 6px;
  }
  .opt {
    color: var(--gray-500);
    margin-left: 6px;
  }

  /* 入力欄は枠線で囲まず下線1本のみ。フォーカスで色だけ変え、太さは変えない（第6-4章） */
  /* Linear風：角丸の枠線ボックス入力 */
  .cform input[type='text'],
  .cform input[type='email'],
  .cform select,
  .cform textarea {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 11px 14px;
    color: var(--text);
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }
  .cform textarea {
    resize: vertical;
  }
  .cform input::placeholder,
  .cform textarea::placeholder {
    color: var(--text-3);
  }
  .cform input:focus,
  .cform select:focus,
  .cform textarea:focus {
    outline: none;
    border-color: var(--border-strong);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.04);
  }

  /* エラー表示：色だけに頼らず必ずテキストも添える（第6-4章・第10章） */
  .err {
    display: none;
    margin-top: 8px;
    color: var(--vermillion);
    font-size: 0.8125rem;
  }
  .cform input:user-invalid,
  .cform select:user-invalid,
  .cform textarea:user-invalid {
    border-color: var(--vermillion);
  }
  /* required（未入力）系：単一の .err を表示 */
  .field:has(input:user-invalid) .err:not(.err-required):not(.err-email),
  .field:has(select:user-invalid) .err,
  .field:has(textarea:user-invalid) .err {
    display: block;
  }
  /* メール：空なら必須、入力ありで不正なら形式エラー（placeholder=" " を利用） */
  .field:has(#cf-email:user-invalid:placeholder-shown) .err-required {
    display: block;
  }
  .field:has(#cf-email:user-invalid:not(:placeholder-shown)) .err-email {
    display: block;
  }

  /* 同意チェック */
  .field-check {
    gap: 8px;
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
    color: var(--gray-500);
    font-size: 0.9375rem;
  }
  .check input {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    accent-color: var(--vermillion);
    flex: none;
  }
  .field-check:has(input:user-invalid) .err-check {
    display: block;
  }

  .clipper-note {
    margin-top: 14px;
    padding: 14px 16px;
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .clipper-note .zi-textlink {
    white-space: nowrap;
  }

  .cform-submit {
    align-self: flex-start;
    margin-top: 8px;
  }
</style>
