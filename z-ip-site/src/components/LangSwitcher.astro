---
import { locales, htmlLang, getLocalizedPath, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** ダーク面(true)かライト面(false)か。現在言語の色を出し分ける */
  onDark?: boolean;
}

const { locale, onDark = true } = Astro.props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;

// 3言語を横並びで常時表示。ドロップダウンにはしない（第5-2章）。
const labels: Record<Locale, string> = {
  ja: t.lang.ja,
  en: t.lang.en,
  zh: t.lang.zh,
};
---

<nav class="lang-switcher" aria-label={t.lang.switchAria} data-on-dark={onDark}>
  {
    locales.map((loc, i) => (
      <>
        {i > 0 && (
          <span class="sep" aria-hidden="true">
            /
          </span>
        )}
        {loc === locale ? (
          <span class="current" aria-current="true" lang={htmlLang[loc]}>
            {labels[loc]}
          </span>
        ) : (
          <a
            href={getLocalizedPath(currentPath, loc)}
            hreflang={htmlLang[loc]}
            lang={htmlLang[loc]}
          >
            {labels[loc]}
          </a>
        )}
      </>
    ))
  }
</nav>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  .lang-switcher a {
    color: var(--gray-400);
    transition: color 150ms ease;
  }
  .lang-switcher a:hover {
    color: var(--paper);
  }
  .lang-switcher[data-on-dark='false'] a {
    color: var(--gray-500);
  }
  .lang-switcher[data-on-dark='false'] a:hover {
    color: var(--ink-800);
  }
  /* 現在の言語：ダーク面は紙、ライト面は墨 */
  .current {
    color: var(--paper);
  }
  .lang-switcher[data-on-dark='false'] .current {
    color: var(--ink-800);
  }
  .sep {
    color: var(--gray-400);
    opacity: 0.5;
  }
</style>
