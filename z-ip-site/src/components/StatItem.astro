---
// [T-6] 数値ストリップ用。確定値が出るまで TOP では描画しない（第9章：未確定数値の掲載禁止）。
interface Props {
  value: string;
  label: string;
  onDark?: boolean;
}
const { value, label, onDark = false } = Astro.props;
---

<div class="stat" data-on-dark={onDark}>
  <span class="stat-value">{value}</span>
  <span class="stat-label zi-label">{label}</span>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stat-value {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .stat-label {
    color: var(--gray-500);
  }
  .stat[data-on-dark='true'] .stat-label {
    color: var(--gray-400);
  }
</style>
