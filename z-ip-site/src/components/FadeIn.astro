---
interface Props {
  /** ラップ要素のタグ */
  as?: keyof HTMLElementTagNameMap;
  /** 遅延ms（連続要素を少しずつずらす） */
  delay?: number;
  class?: string;
}
const { as = 'div', delay = 0, class: className = '' } = Astro.props;
const Tag = as;
---

<Tag class:list={['zi-fade', className]} style={delay ? `transition-delay:${delay}ms` : undefined}>
  <slot />
</Tag>

<script>
  // 許可されたクライアントJS③：スクロール連動フェードイン（IntersectionObserver）。
  const els = document.querySelectorAll<HTMLElement>('.zi-fade');
  if (!('IntersectionObserver' in window) || els.length === 0) {
    els.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
